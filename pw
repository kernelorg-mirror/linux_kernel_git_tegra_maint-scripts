@series.command('ignore')
@click.argument('ids', type = int, nargs = -1, required = True)
@click.pass_obj
def series_ignore(obj, ids):
    for id in ids:
        obj.db.remove_series(id)

if __name__ == '__main__':
    cli(obj = ContextObject())
